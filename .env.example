# ==============================================================================
# n8n Self-Host Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env before starting: cp .env.example .env
# Replace the placeholder values below with your actual configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Network Configuration
# ------------------------------------------------------------------------------
# The fully qualified domain name pointing to your n8n instance (via Cloudflare Tunnel)
DOMAIN_NAME=n8n.yourdomain.com

# Timezone for workflow scheduling and log timestamps
GENERIC_TIMEZONE=UTC

# Webhook and Base URL settings (Crucial for OAuth and Webhook callbacks)
WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com/

# ------------------------------------------------------------------------------
# 2. Security & Encryption Key
# ------------------------------------------------------------------------------
# A strong, unique encryption key used to encrypt all stored credentials (API keys, OAuth tokens).
# IMPORTANT: Never lose or change this once set, otherwise saved credentials cannot be decrypted!
# Generate one using: openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_key_e_g_openssl_rand_hex_24

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=replace_with_a_very_strong_db_password
POSTGRES_DB=n8n_db

# ------------------------------------------------------------------------------
# 4. n8n Execution & Performance Options
# ------------------------------------------------------------------------------
# Automatically prune execution history to save disk space
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168     # Retention in hours (168h = 7 days)
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Telemetry and diagnostics (Set to false for privacy)
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
